<!-- MySQL 互換のテスト集（compat/README.md）。scripts/compat/run.sh が、wordpress-develop を /app に、このディレクトリを
     /compat にマウントしたコンテナで、/app から vendor/bin/phpunit -c /compat/phpunit.xml で流す。 -->
<phpunit
	bootstrap="/compat/bootstrap.php"
	backupGlobals="false"
	colors="false"
	cacheResult="false"
	beStrictAboutTestsThatDoNotTestAnything="false"
	>
	<php>
		<const name="WP_TESTS_CONFIG_FILE_PATH" value="/compat/wp-tests-config.php"/>
	</php>
	<testsuites>
		<testsuite name="compat">
			<directory suffix="Test.php">/compat/tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
