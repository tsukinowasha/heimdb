string("INSERT INTO wp_postmeta (post_id, meta_key, meta_value) WITH RECURSIVE n (i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 0x00ff), k (j) AS (SELECT 0 UNION ALL SELECT j + 1 FROM k WHERE j < 15) SELECT i, ELT(j + 1, 'category', '_category', 'priority', '_priority', 'event_date', '_event_date', 'featured', '_featured', 'summary', '_summary', 'source', '_source', '_edit_lock', '_edit_last', '_thumbnail_id', '_wp_old_slug'), ELT(j + 1, CONCAT('cat', (i * 7) % 10), 'field_category', (i * 37) % 1000, 'field_priority', DATE_FORMAT('2024-01-01' + INTERVAL (i * 13) % @30 DAY, '%Y%m%d'), 'field_event_date', IF(i % 9 = 0, '1', '0'), 'field_featured', CONCAT('Summary ', i), 'field_summary', 'wire', 'field_source', '1700000000:1', '1', '0', CONCAT('news-old-', i)) FROM n, k ORDER BY i, j")
